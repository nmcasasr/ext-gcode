
M82 ;absolute extrusion mode
; Start G-code
G92 E0 ; Reset Extruder
G28 ; Home all axes
M140 S70 ; heat bed
M105
M190 S70 ; wait for bed to be hot
M104 S250; heat nozzle to PETG temp 
M105
M109 S250; wait for nozzle to be hot

G1 Z2.0 F3000 ;			Move Z Axis up little to prevent scratching of Heat Bed
G1 X0.1 Y20 Z0.3 F5000.0 ;	Move to start position
G1 X0.1 Y179.0 Z0.4 F1500.0 E20 ; Draw the first line
G1 X0.4 Y179.0 Z0.4 F5000.0 ; 	Move to side a little
G1 X0.4 Y20 Z0.4 F1500.0 E50 ; 	Draw the second line
G92 E0 ; Reset Extruder
G1 Z2.0 F3000;	 		Move Z Axis up little to prevent scratching of Heat Bed
G1 X5 Y20 Z0.4 F5000.0 ; 	Move over to prevent blob squishING

G92 E0
G1 F1200 E-0.5

M83; use relative extrusions

;-------------------------------------------------------------------- Editable code start
; M221 set flow rate 
; this can be adjusted to fix under or over extrusion problems without re-exporting g-code  
; e.g. M221 S120 will increase to 120% the amount of plastic coming out the nozzle
M221 S100; flow rate 100% 

; M220 Set print speed
M220 S100 ; 100% speed
M104 S240; heat nozzle to PETG temp 
M106 S0 ;  fan off
;--------------------------------------------------------------------- Editable code end

G10 
G1 F12000
G1 Z10.0
G1 X101.717 Y90.0
G1 Z0.8
G1 F240
G11 

